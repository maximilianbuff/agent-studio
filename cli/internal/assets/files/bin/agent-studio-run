#!/usr/bin/env bash
# agent-studio-run <job>
# Runs a headless Claude session using the prompt at
# $AGENT_STUDIO_HOME/prompts/<job>.md.
# Invoked by cron — uses per-job flock(s) to prevent overlapping runs.
set -euo pipefail

JOB="${1:?Usage: agent-studio-run <job-name>}"
STUDIO_HOME="${AGENT_STUDIO_HOME:-$HOME/.agent-studio}"
PROMPT_FILE="$STUDIO_HOME/prompts/${JOB}.md"
LOG_FILE="$STUDIO_HOME/logs/${JOB}.log"
CONFIG_FILE="$STUDIO_HOME/config.json"

# Cron strips the user environment — source profile to restore PATH.
# shellcheck disable=SC1090,SC1091
for f in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.zprofile"; do
  [[ -f "$f" ]] && source "$f" && break
done

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "[agent-studio-run] prompt not found: $PROMPT_FILE" >&2
  exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"

# --- Auth mode ---
if [[ -f "$CONFIG_FILE" ]]; then
  AUTH_MODE=$(jq -r '.auth_mode // "subscription"' "$CONFIG_FILE" 2>/dev/null || echo "subscription")
  if [[ "$AUTH_MODE" == "api_key" ]]; then
    API_KEY=$(jq -r '.anthropic_api_key // ""' "$CONFIG_FILE" 2>/dev/null || echo "")
    if [[ -n "$API_KEY" ]]; then
      export ANTHROPIC_API_KEY="$API_KEY"
    fi
  fi
fi

# --- Numbered lockfile concurrency ---
# For the worker job, honour max_workers from config.
# For all other jobs, always use a single lock (MAX_WORKERS=1).
if [[ "$JOB" == "worker" ]] && [[ -f "$CONFIG_FILE" ]]; then
  MAX_WORKERS=$(jq -r '.max_workers // 1' "$CONFIG_FILE" 2>/dev/null || echo "1")
  # Ensure it's a positive integer.
  [[ "$MAX_WORKERS" =~ ^[1-9][0-9]*$ ]] || MAX_WORKERS=1
else
  MAX_WORKERS=1
fi

CLAIMED=0
LOCK_FD=""
for i in $(seq 1 "$MAX_WORKERS"); do
  LOCK_FILE="$STUDIO_HOME/${JOB}-${i}.lock"
  exec {LOCK_FD}>>"$LOCK_FILE"
  if flock -n "$LOCK_FD"; then
    CLAIMED=1
    echo $$ >"$LOCK_FILE"
    break
  fi
done

if [[ "$CLAIMED" -eq 0 ]]; then
  echo "[agent-studio-run] $JOB: all $MAX_WORKERS slot(s) busy, skipping" >&2
  exit 0
fi

echo "[agent-studio-run] starting $JOB (pid $$, slot $i) at $(date -u +%FT%TZ)"

exec claude --dangerously-skip-permissions -p "$(cat "$PROMPT_FILE")"
