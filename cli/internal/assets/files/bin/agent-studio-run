#!/usr/bin/env bash
# agent-studio-run <job>
# Dispatcher for AgentStudio cron jobs.
# - scan: routes to native `studio scan` (no Claude)
# - worker: checks queue, then runs Claude with worker.md prompt
# Invoked by cron — uses per-job flock(s) to prevent overlapping runs.
set -euo pipefail

JOB="${1:?Usage: agent-studio-run <job-name>}"
STUDIO_HOME="${AGENT_STUDIO_HOME:-$HOME/.agent-studio}"
LOG_FILE="$STUDIO_HOME/logs/${JOB}.log"

# Cron strips the user environment — source profile to restore PATH.
# shellcheck disable=SC1090,SC1091
for f in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.zprofile"; do
  [[ -f "$f" ]] && source "$f" && break
done

mkdir -p "$(dirname "$LOG_FILE")"

# --- Numbered lockfile concurrency (worker only, others use single lock) ---
if [[ "$JOB" == "worker" ]]; then
  MAX_WORKERS=$(studio config get jobs.worker.concurrency 2>/dev/null || echo "1")
  [[ "$MAX_WORKERS" =~ ^[1-9][0-9]*$ ]] || MAX_WORKERS=1
else
  MAX_WORKERS=1
fi

CLAIMED=0
SLOT=1
for i in $(seq 1 "$MAX_WORKERS"); do
  LOCK_FILE="$STUDIO_HOME/${JOB}-${i}.lock"
  exec {LOCK_FD}>>"$LOCK_FILE"
  if flock -n "$LOCK_FD"; then
    CLAIMED=1
    SLOT=$i
    echo $$ >"$LOCK_FILE"
    break
  fi
done

if [[ "$CLAIMED" -eq 0 ]]; then
  echo "[agent-studio-run] $JOB: all $MAX_WORKERS slot(s) busy, skipping" >&2
  exit 0
fi

echo "[agent-studio-run] starting $JOB (pid $$, slot $SLOT) at $(date -u +%FT%TZ)"

# --- Route scan to native studio command (no Claude) ---
if [[ "$JOB" == "scan" ]]; then
  exec studio scan
fi

# --- For worker jobs: prioritize DB → queue.json, then check count ---
if [[ "$JOB" == "worker" ]]; then
  if ! studio work prioritize 2>&1 | sed 's/^/[agent-studio-run] /'; then
    echo "[agent-studio-run] prioritize failed, skipping worker" >&2
    exit 0
  fi
  QUEUE_COUNT=$(studio queue count 2>/dev/null || echo "0")
  if [[ "$QUEUE_COUNT" -eq 0 ]]; then
    echo "[agent-studio-run] queue empty after prioritize, skipping worker" >&2
    exit 0
  fi
  echo "[agent-studio-run] queue has $QUEUE_COUNT item(s), starting worker"
fi

PROMPT_FILE="$STUDIO_HOME/prompts/${JOB}.md"
if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "[agent-studio-run] prompt not found: $PROMPT_FILE" >&2
  exit 1
fi

# --- Auth mode ---
AUTH_MODE=$(studio config get auth_mode 2>/dev/null || echo "subscription")
if [[ "$AUTH_MODE" == "api_key" ]]; then
  API_KEY=$(studio config get anthropic_api_key 2>/dev/null || echo "")
  if [[ -n "$API_KEY" ]]; then
    export ANTHROPIC_API_KEY="$API_KEY"
  fi
fi

# --- Repomix pre-context (worker only) ---
REPOMIX_CONTEXT=""
if [[ "$JOB" == "worker" ]]; then
  REPOMIX_ENABLED=$(studio config get repomix_enabled 2>/dev/null || echo "true")
  if [[ "$REPOMIX_ENABLED" == "true" ]] && command -v npx &>/dev/null; then
    FIRST_REPO=$(studio queue peek 2>/dev/null || echo "")
    if [[ -n "$FIRST_REPO" ]]; then
      REPO_SLUG="${FIRST_REPO//\//-}"
      CACHE_DATE=$(date +%Y-%m-%d)
      REPOMIX_CACHE="/tmp/repomix-${REPO_SLUG}-${CACHE_DATE}.txt"
      REPO_NAME="${FIRST_REPO##*/}"
      REPO_DIR="/tmp/agent-studio-work/${REPO_NAME}"
      if [[ ! -f "$REPOMIX_CACHE" ]]; then
        echo "[agent-studio-run] generating repomix context for $FIRST_REPO"
        mkdir -p /tmp/agent-studio-work
        git clone "https://github.com/$FIRST_REPO" "$REPO_DIR" 2>/dev/null \
          || git -C "$REPO_DIR" pull --rebase 2>/dev/null || true
        if [[ -d "$REPO_DIR" ]]; then
          npx --yes repomix "$REPO_DIR" \
            --output "$REPOMIX_CACHE" \
            --ignore "node_modules,dist,*.lock,*.log,.git,coverage" \
            2>/dev/null || true
        fi
      fi
      if [[ -f "$REPOMIX_CACHE" ]]; then
        echo "[agent-studio-run] injecting repomix context ($REPOMIX_CACHE)"
        REPOMIX_CONTEXT="<repo-context repo=\"${FIRST_REPO}\" generated=\"${CACHE_DATE}\">
$(cat "$REPOMIX_CACHE")
</repo-context>

"
      fi
    fi
  fi
fi

PROMPT="$(cat "$PROMPT_FILE")"
exec claude --dangerously-skip-permissions -p "${REPOMIX_CONTEXT}${PROMPT}"
